# ============================================================
# AHICF — Git Ignore Rules
# ============================================================

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Jupyter
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE / editor files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
*.tmp
*.temp

# Python build/package files
build/
dist/
*.egg-info/

# ============================================================
# AHICF generated outputs
# ============================================================

# Trained models / checkpoints
*.pt
*.pth
*.ckpt
*.onnx
*.joblib

# Large generated feature files
*.npy
*.npz
*.pkl
*.pickle

# Generated processed data
Processed/

# Local datasets
Dataset/

# Local AHICF project outputs
models/
outputs/

# ============================================================
# Local configuration / secrets
# ============================================================

.env
.env.*
